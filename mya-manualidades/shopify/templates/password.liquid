{% layout 'password' %}
<main class="pw">
  <img src="{{ 'mya-mark.png' | asset_url }}" alt="MYA Manualidades" width="312" height="266">
  <h1>MYA</h1>
  <p class="sub">MANUALIDADES</p>
  <p class="soon">Muy pronto abrimos nuestra tienda</p>
  {% form 'storefront_password' %}
    <label for="pwInput">Contraseña de la tienda</label>
    <input type="password" name="password" id="pwInput" autocomplete="current-password" required>
    {% if form.errors %}<p class="err">La contraseña no es correcta. Revísala e inténtalo otra vez.</p>{% endif %}
    <button type="submit">Entrar</button>
  {% endform %}
  <p class="owner">¿Eres la dueña de la tienda? <a href="/admin">Entra al panel de Shopify</a></p>
</main>
