<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ shop.name }} · Próximamente</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Montserrat:wght@400;500&display=swap">
{{ content_for_header }}
<style>
  :root { --paper: #ece8e1; --card: #faf8f4; --copper: #a8623c; --copper-dark: #6e3a22; --ink: #4a2a1a; }
  html, body { height: 100%; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Montserrat", Arial, sans-serif; display: grid; place-items: center; padding: 24px 16px; box-sizing: border-box; }
  .pw { width: 100%; max-width: 420px; text-align: center; background: var(--card); border-radius: 16px; padding: 32px 24px; box-shadow: 0 20px 50px rgba(74, 42, 26, .15); }
  .pw img { width: 120px; height: auto; }
  .pw h1 { margin: 8px 0 0; font: 600 44px/1 "Cormorant Garamond", Georgia, serif; letter-spacing: .06em; color: var(--copper-dark); }
  .pw .sub { margin: 6px 0 0; font-size: 12px; letter-spacing: .34em; color: var(--copper-dark); }
  .pw .soon { margin: 18px 0 22px; font: italic 500 22px/1.3 "Cormorant Garamond", Georgia, serif; color: var(--copper); }
  .pw label { display: block; text-align: left; font-size: 13px; margin-bottom: 6px; color: var(--copper-dark); }
  .pw input[type=password] { width: 100%; box-sizing: border-box; font: 16px "Montserrat", Arial, sans-serif; padding: 12px 14px; border: 1px solid rgba(110, 58, 34, .35); border-radius: 10px; background: #fff; }
  .pw input[type=password]:focus { outline: 2px solid var(--copper); border-color: transparent; }
  .pw button { margin-top: 14px; width: 100%; font: 500 13px/1 "Montserrat", Arial, sans-serif; letter-spacing: .2em; text-transform: uppercase; color: var(--card); background: linear-gradient(135deg, #c07b52, var(--copper) 50%, var(--copper-dark)); border: 0; border-radius: 999px; padding: 15px; cursor: pointer; }
  .pw .err { margin: 10px 0 0; color: #a33a1c; font-size: 13px; }
  .pw .owner { margin-top: 18px; font-size: 12px; color: var(--copper-dark); }
  .pw .owner a { color: var(--copper-dark); }
</style>
</head>
<body>
{{ content_for_layout }}
</body>
</html>
